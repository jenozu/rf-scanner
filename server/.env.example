# Backend environment variables (copy to server/.env for local dev)

NODE_ENV=development
PORT=3001

# Where JSON data files are stored. Defaults to ./data (relative to server/) if not set.
DATA_DIR=

# Optional. Comma-separated browser origins allowed to call the API cross-origin.
# Leave empty when the app is served from the same host as /api (the normal setup).
CORS_ORIGINS=

# REQUIRED. The server refuses to start without it (at least 32 characters, and not
# a placeholder). Generate one with:  openssl rand -hex 48
# Changing it later signs every user out once.
# Local dev: the server does not read this file by itself. Either export JWT_SECRET
# first, or run:  node --env-file=.env --watch index.js
JWT_SECRET=

# First admin: there is no default login. Run once:  ADMIN_PASSWORD=... node reset-admin.js  (see readme.md)

# SAP SQL Server connection (only needed for inventory/PO export scripts)
SQL_SERVER=
SQL_DATABASE=
SQL_USER=
SQL_PASSWORD=
DB_DRIVER={ODBC Driver 17 for SQL Server}

# Purolator shipping API (only needed for shipping features)
PUROLATOR_API_USERNAME=
PUROLATOR_API_PASSWORD=
PUROLATOR_API_ACCOUNT=

# Email for shipping labels (optional)
EMAIL_FROM=
EMAIL_PASSWORD=
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
